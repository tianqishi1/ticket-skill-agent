# ============================================================
# 环境变量样例 —— 拷贝为 .env 后填写真实值
# 重要：本文件仅占位符，禁止硬编码任何真实 API Key。
# 基础设施（Milvus/MySQL/Redis）通过 docker-compose 拉起，默认 localhost。
# ============================================================

# ---------- LLM（豆包 / Ark OpenAI 兼容接口） ----------
# API Key（必填）
API_KEY=your_doubao_api_key_here

# OpenAI 兼容 Base URL（豆包 Ark 网关）
BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 模型名称（豆包 Seed 系列，按你账号开通的 endpoint 填写）
MODEL_NAME=doubao-seed-1-6-250715

# LLM 单次请求超时（秒）
LLM_TIMEOUT=60

# LLM 调用失败重试次数（指数退避）
LLM_MAX_RETRIES=2

# LLM 限流：每窗口最大调用次数 / 窗口秒数（按租户维度计数，Redis 不可用时进程内退化）
LLM_RATE_LIMIT=30
LLM_RATE_WINDOW=60

# MCP 文件工具单次调用超时（秒）
MCP_TIMEOUT=30

# ---------- 租户隔离 ----------
# 默认租户（CLI 也可用 --tenant 覆盖；所有外部查询强制带 tenant_id）
TENANT_ID=default

# ---------- Milvus（向量库） ----------
MILVUS_URI=http://localhost:19530
# 如启用鉴权填写 token，否则留空
MILVUS_TOKEN=
# Milvus 客户端超时（秒，用于连接/列表探测）
MILVUS_TIMEOUT=5

# ---------- MySQL（工单持久化 + 长期记忆） ----------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=ticket_agent
MYSQL_PASSWORD=ticket_agent_pwd
MYSQL_DATABASE=ticket_agent

# ---------- Redis（会话缓存 + LLM 限流） ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
